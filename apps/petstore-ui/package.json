{
  "name": "@response-capture/petstore-ui",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "test:e2e": "tsc -p tsconfig.e2e.json && playwright test",
    "test:e2e:harness": "tsc -p tsconfig.e2e.json && playwright test --project=harness",
    "dev": "ng serve"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@response-capture/contracts": "*",
    "@response-capture/ui": "*",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.26",
    "@angular/cli": "^21.2.26",
    "@angular/compiler-cli": "^21.2.0",
    "@playwright/test": "1.56.1",
    "@response-capture/scenario-client": "*",
    "@tailwindcss/postcss": "^4.1.12",
    "@types/node": "24.10.1",
    "axe-core": "^4.14.0",
    "jsdom": "^28.0.0",
    "postcss": "^8.5.3",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.1.12",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
