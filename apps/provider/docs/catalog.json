{
  "catalogVersion": 1,
  "scenarios": [
    {
      "category": "Pets",
      "description": "An empty request is rejected because a name and photo URLs are required.",
      "group": "Create a pet",
      "id": "pet.create.invalid",
      "request": {
        "body": {},
        "method": "POST",
        "path": "/pet"
      },
      "response": {
        "body": {
          "error": "Bad Request",
          "message": [
            "name must match /\\S/ regular expression",
            "name must be a string",
            "each value in photoUrls must be a string",
            "photoUrls must be an array"
          ],
          "statusCode": 400
        },
        "headers": {
          "content-type": "application/json; charset=utf-8"
        },
        "status": 400
      },
      "schemaVersion": 1,
      "tags": [],
      "title": "Reject a pet with missing fields"
    },
    {
      "category": "Pets",
      "description": "Creates Milo with no category or tags and the default available status.",
      "group": "Create a pet",
      "id": "pet.create.success",
      "request": {
        "body": {
          "name": "Milo",
          "photoUrls": [
            "https://example.com/milo.jpg"
          ]
        },
        "match": {
          "bodyContains": {
            "name": "Milo"
          }
        },
        "method": "POST",
        "path": "/pet"
      },
      "response": {
        "body": {
          "id": 1,
          "name": "Milo",
          "photoUrls": [
            "https://example.com/milo.jpg"
          ],
          "status": "available",
          "tags": []
        },
        "headers": {
          "content-type": "application/json; charset=utf-8"
        },
        "status": 201
      },
      "schemaVersion": 1,
      "tags": [
        "defaults"
      ],
      "title": "Create a pet with defaults"
    },
    {
      "category": "Pets",
      "description": "Creates a sold pet with an explicit category and tag.",
      "group": "Create a pet",
      "id": "pet.create.with-category-and-tags",
      "request": {
        "body": {
          "category": {
            "id": 1,
            "name": "Cat"
          },
          "name": "Milo",
          "photoUrls": [
            "https://example.com/milo.jpg"
          ],
          "status": "sold",
          "tags": [
            {
              "id": 2,
              "name": "cute"
            }
          ]
        },
        "method": "POST",
        "path": "/pet"
      },
      "response": {
        "body": {
          "category": {
            "id": 1,
            "name": "Cat"
