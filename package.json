{
  "name": "response-capture",
  "version": "0.0.0",
  "private": true,
  "packageManager": "npm@11.8.0",
  "engines": {
    "node": ">=24 <25",
    "npm": "11.8.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "dev": "turbo run dev",
    "lint:petstore-api": "npm run lint --workspace=@response-capture/petstore-api",
    "test:e2e": "turbo run test:e2e --filter=@response-capture/petstore-api --filter=catalog-api",
    "test:e2e:ui": "turbo run test:e2e --filter=@response-capture/petstore-ui",
    "scenarios:merge": "turbo run scenarios:merge --filter=@response-capture/petstore-api",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "prepare": "npm run build --workspace=@response-capture/contracts && npm run build --workspace=@response-capture/scenario-recorder && npm run build --workspace=@response-capture/scenario-client",
    "scenarios:capture": "turbo run scenarios:capture --filter=@response-capture/petstore-api",
    "scenarios:submit": "turbo run scenarios:submit --filter=@response-capture/petstore-api",
    "test:contract": "turbo run test:contract --filter=@response-capture/petstore-ui"
  },
  "devDependencies": {
    "turbo": "^2.9.0",
    "prettier": "3.9.9"
  }
}
