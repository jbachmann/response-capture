{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!dist/**",
        "!build/**",
        "!coverage/**",
        "!.angular/**",
        "!out-tsc/**",
        "!.tmp/**",
        "!.temp/**",
        "!artifacts/**",
        "!data/**",
        "!**/*.tsbuildinfo",
        "!**/*.sqlite",
        "!**/*.sqlite-*",
        "!**/*.sqlite3",
        "!**/*.sqlite3-*",
        "!**/*.db",
        "!**/*.db-*"
      ],
      "outputs": [
        "dist/**",
        "*.tsbuildinfo"
      ]
    },
    "test": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!dist/**",
        "!build/**",
        "!coverage/**",
        "!.angular/**",
        "!out-tsc/**",
        "!.tmp/**",
        "!.temp/**",
        "!artifacts/**",
        "!data/**",
        "!**/*.tsbuildinfo",
        "!**/*.sqlite",
        "!**/*.sqlite-*",
        "!**/*.sqlite3",
        "!**/*.sqlite3-*",
        "!**/*.db",
        "!**/*.db-*"
      ],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "PORT",
        "DATABASE_PATH",
        "CATALOG_DATABASE_PATH"
      ]
    },
    "test:e2e": {
      "cache": false
    },
    "scenarios:merge": {
      "cache": false,
      "passThroughEnv": [
        "CATALOG_API_URL",
        "CATALOG_ALIAS"
      ]
    }
  },
  "globalPassThroughEnv": [
    "NG_BUILD_MAX_WORKERS"
  ],
  "remoteCache": {
    "enabled": false
  }
}
